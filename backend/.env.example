# 复制成 .env 后按需修改：
#   cp .env.example .env        # Linux / macOS
#   Copy-Item .env.example .env # Windows PowerShell
#
# 真实值只写在本地的 .env 里；.env 已被 .gitignore 忽略，不要提交。

# ---------- PostgreSQL 连接 ----------
# 对应 database.py 中的 DATABASE_HOST / DATABASE_USERNAME / DATABASE_PASSWORD / DATABASE_NAME。
# 注意：端口在 database.py 里固定为 5432，所以这里没有 DATABASE_PORT。
DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=tallywise

# ---------- JWT 签名密钥 ----------
# 必须替换成随机字符串，泄露等于任何人都能伪造登录态。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret

# ---------- Cookie 安全开关 ----------
# 控制登录 Cookie 是否带 Secure 属性（routers/users.py）。
# 本地 http 调试用 false；线上 https 部署必须改成 true，否则 Cookie 会被浏览器拒收。
# 不设置时默认为 false。
COOKIE_SECURE=false

# ---------- 测试专用数据库 ----------
# 数据库测试才需要；纯单元测试不连接数据库。数据库测试要求显式指定，
# 并且会强制校验：库名必须以 _test 结尾、不能与上面的 DATABASE_NAME 相同、
# 实际连接目标必须是这个库。不满足就拒绝初始化测试库；指定的库必须允许清空。
#
# 建库：psql -U postgres -c "CREATE DATABASE tallywise_test;"
TEST_DATABASE_NAME=tallywise_test
