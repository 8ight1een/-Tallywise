# 本地环境变量（保留配置示例）
.env
.env.*
!.env.example
!.env.*.example

# SQLite 数据库（保留 SQL 建表脚本）
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# 编辑器和系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# 日志
*.log
npm-debug.log*
