# Obsidian 笔记配置
.obsidian/

# Python 虚拟环境和缓存
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 前端依赖、构建产物和工具缓存
node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/coverage/
*.tsbuildinfo
